<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sem INTERNET: a inferência da Haruna é local. -->
    <application android:allowBackup="true" android:label="Haruna" android:icon="@drawable/haruna_launcher" android:roundIcon="@drawable/haruna_launcher" android:theme="@style/Theme.Haruna" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>