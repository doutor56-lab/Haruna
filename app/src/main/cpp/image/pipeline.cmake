# Build the pinned upstream SD1.5 pipeline and tokenizer, without another LLM engine.
set(SD_SRC ${mnn_image_SOURCE_DIR}/transformers/diffusion/engine)
set(SD_OUT ${CMAKE_CURRENT_BINARY_DIR}/sd15)
file(MAKE_DIRECTORY ${SD_OUT}/diffusion)
configure_file(${SD_SRC}/include/diffusion/stable_diffusion.hpp ${SD_OUT}/diffusion/stable_diffusion.hpp COPYONLY)
configure_file(${SD_SRC}/include/diffusion/diffusion.hpp ${SD_OUT}/diffusion/diffusion.hpp COPYONLY)
file(READ ${SD_SRC}/src/stable_diffusion.cpp SD_CODE)
string(PREPEND SD_CODE "#include \"pipeline_hooks.h\"\n")
string(REPLACE "mPromptVar->writeMap<int8_t>();" "memset(mPromptVar->writeMap<int8_t>(),0,2*mMaxTextLen*sizeof(int));" SD_CODE "${SD_CODE}")
string(REPLACE "mLatentVar->writeMap<int8_t>();" "memset(mLatentVar->writeMap<int8_t>(),0,16384*sizeof(float));" SD_CODE "${SD_CODE}")
string(REPLACE "mTimestepVar->writeMap<int8_t>();" "memset(mTimestepVar->writeMap<int8_t>(),0,sizeof(int));" SD_CODE "${SD_CODE}")
string(REPLACE "config.numThread = 4;" "config.numThread = 2;" SD_CODE "${SD_CODE}")
string(REPLACE "// tokenizer loading" "for(const auto & m:mModules)if(!m)return false;\n    image_checkpoint(1,0,1);\n    // tokenizer loading" SD_CODE "${SD_CODE}")
string(REPLACE "return mModules[index]->onForward(inputs);" "auto result=mModules[index]->onForward(inputs);if(result.empty()||result[0].get()==nullptr||!result[0]->getInfo())throw std::runtime_error(\"MNN module failed\");return result;" SD_CODE "${SD_CODE}")
string(REPLACE "        int timestep = mTimeSteps[i];" "image_checkpoint(3,i,iterNum);\n        int timestep = mTimeSteps[i];" SD_CODE "${SD_CODE}")
string(REPLACE "plms = step_plms(plms, noise_pred, i);" "noise_pred.fix(VARP::CONSTANT);\n        plms = step_plms(plms, noise_pred, i);\n        if(!plms->readMap<float>())throw std::runtime_error(\"MNN denoise failed\");\n        plms.fix(VARP::CONSTANT);image_checkpoint(3,i+1,iterNum);" SD_CODE "${SD_CODE}")
string(REPLACE "auto image = vae_decoder(latent);" "image_checkpoint(4,0,1);auto image = vae_decoder(latent);if(image.get()==nullptr||!image->readMap<uint8_t>())throw std::runtime_error(\"MNN VAE failed\");image_checkpoint(4,1,1);" SD_CODE "${SD_CODE}")
string(REPLACE "bool res = imwrite(imagePath, image);" "image_checkpoint(5,0,1);bool res = imwrite(imagePath, image);if(!res)throw std::runtime_error(\"PNG write failed\");image_checkpoint(5,1,1);" SD_CODE "${SD_CODE}")
string(REPLACE "auto text_embeddings = text_encoder(ids);" "image_checkpoint(2,0,1);auto text_embeddings = text_encoder(ids);image_checkpoint(2,1,1);" SD_CODE "${SD_CODE}")
file(WRITE ${SD_OUT}/stable_diffusion.cpp "${SD_CODE}")
target_sources(haruna_image PRIVATE ${SD_OUT}/stable_diffusion.cpp ${SD_SRC}/src/tokenizer.cpp ${SD_SRC}/src/scheduler.cpp ${mnn_image_SOURCE_DIR}/transformers/llm/engine/src/tokenizer/tokenizer.cpp ${CMAKE_CURRENT_LIST_DIR}/pipeline_base.cpp)
target_include_directories(haruna_image PRIVATE ${SD_OUT} ${CMAKE_CURRENT_LIST_DIR} ${SD_SRC}/include ${SD_SRC}/src ${mnn_image_SOURCE_DIR}/source ${mnn_image_SOURCE_DIR}/tools/cv/include ${mnn_image_SOURCE_DIR}/transformers/llm/engine/src/tokenizer)
target_compile_definitions(haruna_image PRIVATE MNN_DIFFUSION_WITH_LLM_TOKENIZER=1)
