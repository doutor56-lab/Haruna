{
  "name": "haruna-windows",
  "version": "0.3.0",
  "private": true,
  "description": "Haruna offline \u2014 interface compartilhada Android/Windows",
  "author": "Jo\u00e3o Victor \u2014 Proxys Labs",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:ui": "node scripts/prepare-ui.cjs",
    "fetch:runtimes": "python scripts/fetch-runtimes.py",
    "test": "node --test test/*.test.cjs",
    "start": "npm run prepare:ui && electron .",
    "dist:win": "npm run prepare:ui && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.proxyslabs.haruna.windows",
    "productName": "Haruna",
    "asar": true,
    "files": [
      "src/**",
      "renderer/**",
      "ui/**",
      "licenses/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtimes",
        "to": "runtimes"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Haruna-Windows-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "icon": "renderer/haruna.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**",
      "node_modules/@napi-rs/**",
      "node_modules/tesseract.js-core/**"
    ],
    "extraFiles": [
      {
        "from": "runtimes/vc-runtime",
        "to": ".",
        "filter": [
          "*.dll"
        ]
      }
    ]
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.1",
    "tar-stream": "3.2.2",
    "unbzip2-stream": "1.4.3",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0",
    "yauzl": "3.4.0"
  }
}
